#include <Wire.h>          // <-- Needed
#include "HUSKYLENS.h"

HUSKYLENS huskylens;
const int led = 7;

void setup() {
  Serial.begin(115200);
  pinMode(led, OUTPUT);     // <-- Configure LED pin
  digitalWrite(led, LOW);   // LED off initially

  Wire.begin();
  while (!huskylens.begin(Wire)) {
    Serial.println(F("Begin failed!"));
    Serial.println(F("1. Check Protocol Type: I2C on HuskyLens"));
    Serial.println(F("2. Check wiring (SDA->A4, SCL->A5 on UNO)"));
    delay(200);
  }
}

void loop() {
  bool detectedThisCycle = false;

  if (!huskylens.request()) {
    Serial.println(F("Request failed, check connection!"));
  } else if (!huskylens.isLearned()) {
    Serial.println(F("Nothing learned. Press Learn on HuskyLens."));
  } else if (huskylens.available()) {
    Serial.println(F("###########"));
    while (huskylens.available()) {
      HUSKYLENSResult result = huskylens.read();

      if (result.command == COMMAND_RETURN_BLOCK) {
        Serial.println(String() + F("Block: x=") + result.xCenter +
                       F(", y=") + result.yCenter +
                       F(", w=") + result.width +
                       F(", h=") + result.height +
                       F(", ID=") + result.ID);
        detectedThisCycle = true;
      } else if (result.command == COMMAND_RETURN_ARROW) {
        Serial.println(String() + F("Arrow: xo=") + result.xOrigin +
                       F(", yo=") + result.yOrigin +
                       F(", xt=") + result.xTarget +
                       F(", yt=") + result.yTarget +
                       F(", ID=") + result.ID);
        detectedThisCycle = true;
      } else {
        Serial.println(F("Unknown object"));
      }
    }
  }

  // LED reflects whether anything was detected in this loop
  digitalWrite(led, detectedThisCycle ? HIGH : LOW);

  delay(30); // small delay to reduce flicker/CPU
}
